              }
            }
          }
        }
      }
    },
    "/api/v1/productos/ajustes/{clave}": {
      "get": {
        "tags": [
          "Productos"
        ],
        "summary": "Obtener Ajuste",
        "description": "GET /api/v1/productos/ajustes/{clave} -> 200 OK o 404 Not Found.\n\nIndica si un ajuste de stock con esa Idempotency-Key llegó a aplicarse.\nLo usa Movimientos para reconciliar un movimiento que quedó \"pendiente\"\n(por ejemplo, porque se cortó la respuesta de ajustar-stock): 200 significa\nque el stock SÍ se modificó; 404, que nunca se aplicó.",
        "operationId": "obtener_ajuste_api_v1_productos_ajustes__clave__get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "clave",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Clave"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AjusteStockOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/productos/{id_producto}": {
      "get": {
        "tags": [
          "Productos"
        ],
        "summary": "Obtener Producto",
        "description": "GET /api/v1/productos/{id} -> 200 OK o 404 Not Found.\n\nDevuelve el producto exista o no esté activo (para permitir, por\nejemplo, ver el detalle de un producto dado de baja).",
        "operationId": "obtener_producto_api_v1_productos__id_producto__get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "id_producto",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Id Producto"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductoOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Productos"
        ],
        "summary": "Actualizar Producto",
        "description": "PUT /api/v1/productos/{id} -> 200 OK o 404 Not Found.\n\nActualiza únicamente los datos descriptivos del producto (nombre, marca,\nprecio_venta, stock_minimo, categoria). NO modifica stock_actual bajo\nninguna circunstancia: el schema ProductoUpdate ni siquiera acepta ese\ncampo (ver issue #6). El stock se gestiona mediante movimientos.",
        "operationId": "actualizar_producto_api_v1_productos__id_producto__put",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "id_producto",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Id Producto"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProductoUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductoOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Productos"
        ],
        "summary": "Eliminar Producto",
        "description": "DELETE /api/v1/productos/{id}.\n\nSolo accesible por admin (issue #7): dar de baja o eliminar un\nproducto es una decisión más sensible que crearlo o editarlo, así que\nse restringe más que el resto del CRUD.\n\nComportamiento (issue #6):\n- 204 No Content: el producto no tenía movimientos asociados y se\n  eliminó físicamente.\n- 200 OK con el producto en el body (activo=false): el producto tenía\n  movimientos asociados, así que se dio de baja lógica en lugar de\n  eliminarlo, para preservar la trazabilidad del historial.\n- 404 Not Found: no existía un producto con ese id.\n- 503 Service Unavailable: no se pudo consultar a Movimientos para saber\n  si hay historial. No se elimina ni se da de baja nada (falla cerrada):\n  borrar físicamente un producto con movimientos perdería trazabilidad.\n\n\"Tiene movimientos asociados\" se resuelve consultando de verdad al\nservicio de Movimientos (con el token del admin que hace la baja).",
        "operationId": "eliminar_producto_api_v1_productos__id_producto__delete",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "id_producto",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Id Producto"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/productos/{id_producto}/ajustar-stock": {
      "patch": {
        "tags": [
          "Productos"
        ],
        "summary": "Ajustar Stock",
        "description": "PATCH /api/v1/productos/{id}/ajustar-stock -> 200 OK, 404 Not Found,\n409 Conflict (sin stock) o 422 (Idempotency-Key reutilizada con otro ajuste).\n\nEndpoint consumido por el servicio de Movimientos para reflejar ventas,\ningresos, estropeos y devoluciones. El ajuste se aplica de forma atómica\n(ver producto_service.ajustar_stock_atomico), por lo que es seguro ante\nllamadas concurrentes: nunca deja stock_actual negativo.\n\nRequiere rol admin o empleado, igual que el resto de los endpoints de\nescritura. El servicio de Movimientos reenvía el JWT del usuario que\noriginó el movimiento.\n\nIdempotencia: si se envía el header opcional Idempotency-Key, el ajuste se\naplica UNA sola vez por clave (la clave se guarda en la misma transacción\nque el cambio de stock). Repetir el pedido con la misma clave y el mismo\ncontenido no vuelve a modificar el stock y devuelve 200 con el producto\nactual. Es lo que permite a Movimientos reintentar o recuperar un\nmovimiento pendiente sin riesgo de descontar dos veces.",
        "operationId": "ajustar_stock_api_v1_productos__id_producto__ajustar_stock_patch",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "id_producto",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Id Producto"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 100
                },
                {
                  "type": "null"
                }
              ],
              "title": "Idempotency-Key"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AjusteStockIn"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductoOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/dev/seed-productos": {
      "post": {
        "tags": [
          "Desarrollo / Datos de prueba"
        ],
        "summary": "Cargar productos de prueba (solo desarrollo)",
        "description": "Genera e inserta `cantidad` productos con nombre, marca, categoría,\nprecio y stock aleatorios (ver app/utils/datos_prueba.py). Pensado para\nel botón \"Cargar datos de prueba\" del frontend.\n\nRequiere estar autenticado (admin o empleado, mismo criterio que\nPOST /productos, ya que generar productos de prueba no es más sensible\nque crear un producto real). Devuelve 403 si\nHABILITAR_SEED_ENDPOINT=false en el entorno, independientemente del rol.",
        "operationId": "seed_productos_api_v1_dev_seed_productos_post",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "cantidad",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 200,
              "minimum": 1,
              "description": "Cantidad de productos a generar (1-200).",
              "default": 20,
              "title": "Cantidad"
            },
            "description": "Cantidad de productos a generar (1-200)."
          }
        ],
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ProductoOut"
                  },
                  "title": "Response Seed Productos Api V1 Dev Seed Productos Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
